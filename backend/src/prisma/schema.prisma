generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id          Int           @id @default(autoincrement())
  name        String
  ownerId     Int?
  createdAt   DateTime      @default(now())

  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  fields      Field[]
  versions    FormVersion[]
  submissions Submission[]

  @@index([ownerId, createdAt])
}

model FormVersion {
  id          Int           @id @default(autoincrement())
  formId      Int
  versionNo   Int
  status      VersionStatus @default(draft)
  title       String?
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
  nodes       FormNode[]
  form        Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([formId, versionNo])
  @@index([formId, status])
}

model Submission {
  id          Int               @id @default(autoincrement())
  formId      Int
  versionId   Int
  submittedAt DateTime          @default(now())
  meta        Json?
  userId      Int?
  form        Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  user        User?             @relation(fields: [userId], references: [id])
  version     FormVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  values      SubmissionValue[]

  @@index([formId, submittedAt])
  @@index([versionId, submittedAt])
  @@index([userId, submittedAt])
}

model SubmissionValue {
  id           Int        @id @default(autoincrement())
  submissionId Int
  nodeId       Int?
  fieldName    String
  value        Json?
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([fieldName])
}

model FormNode {
  id              Int         @id @default(autoincrement())
  versionId       Int
  parentId        Int?
  nodeType        NodeType
  name            String?
  label           String?
  key             String?
  fieldType       String?
  required        Boolean     @default(false)
  position        Int         @default(0)
  column          Int?
  placeholder     String?
  helperText      String?
  options         Json?
  validationRules Json?
  dependencyRules Json?
  designConfig    Json?
  meta            Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  parent          FormNode?   @relation("FormNodeParent", fields: [parentId], references: [id], onDelete: Cascade)
  children        FormNode[]  @relation("FormNodeParent")
  version         FormVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([parentId])
  @@index([versionId, position])
  @@index([versionId, parentId, position])
}

model Field {
  id        Int      @id @default(autoincrement())
  formId    Int
  type      String
  name      String
  label     String
  column    Int?
  createdAt DateTime @default(now())
  options   Json?
  order     Int?
  pattern   String?
  required  Boolean  @default(false)
  uiConfig  Json?
  form      Form     @relation(fields: [formId], references: [id])
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole     @default(user)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  forms        Form[]
  submissions  Submission[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorRole  String
  actorEmail String?
  action     String
  entityType String
  entityId   Int?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum UserRole {
  user
  admin
}

enum VersionStatus {
  draft
  published
  archived
}

enum NodeType {
  page
  group
  multijson
  table
  thead
  tbody
  tr
  th
  td
  field
}
